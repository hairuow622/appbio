# Custom database for the S. pombe ASM294v3 reference used in this project.
# Chromosome names are the RefSeq accessions (NC_003424.3, NC_003423.3,
# NC_003421.2, NC_088682.1), so a prebuilt snpEff database cannot be used.
data.dir = data/snpeff

ASM294v3.genome : Schizosaccharomyces_pombe_ASM294v3
